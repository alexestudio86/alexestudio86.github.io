---

import Layout from "../layouts/Layout.astro";
import HomepageServices from "@components/homepage/homepageServices/HomepageServices.astro";
import HomepageProjects from "@components/homepage/homepageProjects/HomepageProjects.astro";

---


<Layout>
  <main>
    <div class="container">
      <h1>Servicios</h1>
      <HomepageServices />
      <HomepageProjects />
    </div>
  </main>
</Layout>

<style >

  main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  h1 {
    font-size:      var(--fontSize-theme-xlarge);
    text-transform: uppercase;
    padding: 20px 0;
  }

</style>

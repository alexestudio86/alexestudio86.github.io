---

import Layout from "../layouts/Layout.astro";
import Services from "@components/index/services/Services.astro";
import Projects from "@components/index/projects/Projects.astro";

---


<Layout>
  <main>
    <div class="container">
      <h1>Servicios</h1>
      <Services />
      <Projects />
    </div>
  </main>
</Layout>

<style >

  main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  h1 {
    font-size:      var(--fontSize-theme-xlarge);
    text-transform: uppercase;
    padding: 20px 0;
  }

</style>

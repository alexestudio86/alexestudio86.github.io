---

import Layout from "../layouts/Layout.astro";
import Services from "@components/index/services/Services.astro";
import projectIcons from "@components/index/projects/projectsIcons.js";

---

<Layout>
  <main>
    <div class="container">
      <h1>Servicios</h1>
      <Services/>
      <p>
        <a href="/projects">Ver proyectos {projectIcons.southEast && <projectIcons.southEast size="var(--fontSize-theme-medium)" />}</a>
      </p>
    </div>
  </main>
</Layout>

<style >

  main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  h1 {
    font-size:      var(--fontSize-theme-xlarge);
    text-transform: uppercase;
    padding: 20px 0;
  }

  p {
    text-align: right;
    font-size:  var(--fontSize-theme-medium);
    padding:    20px 0;
  }
  
  a {
    text-decoration:  none;
    color:            var(--color-theme-four)
  }

  a:hover {
    color:          white;
  }

</style>

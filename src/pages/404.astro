---

import LayoutNoHeader from "../layouts/LayoutNoHeader.astro";

---

<script>
 document.getElementById('backButton').addEventListener('click', function() {
    window.history.back();
  });
  </script>

<LayoutNoHeader>
  <section class="error">
    <h2>404 NOT FOUND</h2>
    <p class="error__message">La pagina a la que tratas de acceder no existe</p>
  </section>
</LayoutNoHeader>

<style>
  .error {
    width: 100%;
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
  }

  .error__message {
    font-size: 1.8rem;
  }

  .error > *:not(:last-child) {
    margin-bottom: 2rem;
  }
</style>

---

import projectsItems from "./projectsItems.data.json";
import projectsIcons from "./projectsIcons.js";

---

<div class="articles">
    {
        projectsItems.map( (project) => (
            <article>
                <div>
                    <header>
                        <h2>{project.title}</h2>
                    </header>
                    <section>
                        <p>{project.longDesc}</p>
                    </section>
                    <a href={project.slug}></a>
                </div>
                <footer>
                    { project.tech.map( (t, i) => (
                        <input type="radio" name={project.id} id={`${project.id}${i}`} checked={i === 0 && true }/>
                        <label for={`${project.id}${i}`}>{t.category}</label>
                        )
                    ) }
                    <div>
                        {project.tech.map( (t, i) => (
                            <section id={`panel${i}`}>{t.fw.map( (icn, idx) => {
                                const Component = projectsIcons[icn];
                                return Component
                                ? (
                                    <span>
                                        <Component size={'var(--fontSize-theme-large)'} />
                                    </span>
                                  )
                                : null;
                            })}</section>
                        ))}
                    </div>
                </footer>
            </article>
        ))
    }
</div>

<style>

    .articles {
        display:                grid;
        grid-template-columns:  repeat(auto-fit, minmax(350px, 1fr));
        gap:                    10px;
    }

    article {
        background:         var(--color-theme-one);
        border-radius:      10px;
        border:             1px solid rgb(54, 54, 54);
        display:            flex;
        flex-direction:     column;
        justify-content:    space-between;
        transition:         transform 0.3s ease;
    }

    article:hover {
        transform:          scale(1.05);
    }

    article > div {
        position:           relative;
    }

    article > div > header {
        padding:            10px;
    }

    article > div > header > h1 {
        font-size:          var(--fontSize-theme-large);
    }

    article > div > section {
        padding:            10px;
    }

    article > div > section > p {
        font-size:          var(--fontSize-theme-medium);
    }

    article > div > a {
        position:           absolute;
        inset:              0;
        width:              100%;
        height:             100%;
        opacity:            0;
        cursor:             pointer;
    }

    article > footer {
        background:         var(--color-theme-two);
        font-size:          var(--fontSize-theme-medium);
    }

    article > footer > input {
        /*display:        none;*/
    }

    article > footer > input:nth-of-type(1):checked ~ div > section:nth-of-type(1),
    article > footer > input:nth-of-type(2):checked ~ div > section:nth-of-type(2),
    article > footer > input:nth-of-type(3):checked ~ div > section:nth-of-type(3) {
        display:        flex;
        flex-direction: row;
        gap:            5px;
    }

    article > footer > div > section {
        display:    none;
    }

    article > footer > div > section > span {
        filter:     grayscale(100%);
    }

    article > footer > div > section > span:hover {
        filter:     grayscale(0);
    }

</style>
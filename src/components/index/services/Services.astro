---

import servicesItems from "./servicesItems.data.json";
import servicesIcons from "./servicesIcons.js";
import ServicesDialog from "./servicesDialog/ServicesDialog.astro";

const uniqueItem = [
    ...new Set(
        servicesItems.flatMap( (service) => 
            service.item
        )
    )
];

---

<div class="articles">
    <!-- Carga de los svgs desde el principio para reciclarlos, filtrando únicamente los que aparecen en éste componente -->
    {
        uniqueItem.map( (svgIcon) => {
            const Component = servicesIcons[svgIcon];
            return Component
            ? <Component techFW={svgIcon} />
            : null;
        } )
    }
    { servicesItems.length > 0 && servicesItems.map( (service) => (
        <article>
            <div>
                <div>
                    <svg style={`width:var(--fontSize-theme-jumbo); height:var(--fontSize-theme-jumbo)`}>
                        <use href={`#${service.item}-logo-symbol`} />
                    </svg>
                </div>
                <h2>{service.title}</h2>
                <p>{service.shortDesc}</p>
                <button type="button" commandfor={service.id} command="show-modal"></button>
            </div>
        </article>
        <ServicesDialog service={service} />
    )) }
</div>


<style>

    .articles {
        display:                grid;
        grid-template-columns:  repeat(auto-fit,minmax(350px, 1fr));
        gap:                    10px;
    }

    article {
        padding:            10px;
        background:         var(--color-theme-one);
        border-radius:      10px;
        border:             1px solid rgb(54, 54, 54);
        position:           relative;
    }

    article:hover {
        transform:          scale(1.05);
    }

    article > div {
        display:            flex;
        flex-direction:     column;
        justify-content:    space-between;
        height:             200px;
        max-height:         15vh;
        div {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        transition:         transform 0.3s ease;
        h1 {
            font-size:          var(--fontSize-theme-large);
        }
        p {
            font-size:          var(--fontSize-theme-medium);
        }
        button {
            position:           absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity:            0;
            cursor:             pointer;
        }
    }

</style>
---
import brandLogo from "./logo-alexestudio86.png";
---

<header>
  <div class="container">
    <h1>Soy un header</h1>
  </div>
</header>

<style>
header {
  position: fixed; /*A diferencia del fixed, sticky si ocupa espacio, debe estar acompañado por top*/
  width: 100%;
  z-index: 3;
}

nav#navbar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items:center;
  background: var(--color-theme-one);
  border-radius: 18px;
  padding: 20px;
}

input#chkToggle[type="checkbox"] {
  display: none;
}

nav#navbar > label {
  display:none;
  font-size: 22px;
  cursor: pointer;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24px;
  z-index: 5;
}

nav#navbar > ul {
  list-style-type: none;
  display: flex;
  gap: 15px;
}

nav#navbar > a {
  font-size: 22px;
  text-transform: uppercase;
}

nav#navbar > a, nav#navbar > ul > li > a {
  text-decoration: none;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}

nav#navbar > a:hover, nav#navbar > ul > li > a:hover {
  color: rgba(255, 255, 255, 1);
}

@media (width <= 768px) {

  nav#navbar > label {
    display: flex;
  }

  nav#navbar > ul {
    position: fixed;
    top: 0;
    right: -100%;
    width: 100%;
    height: 100vh;
    flex-direction: column;

    background: var(--color-theme-one);
    overflow: hidden;
    transition: 0.3s ease-in-out;
    padding: 80px 40px;
    gap: 8px;
  }
  
  nav#navbar > input:checked ~ ul {
    right: 0;          /* Restauramos el padding */
  }

  nav#navbar > input:checked ~ ul > li {
    border: 1px solid #104343;
    border-radius: 4px;
    padding: 16px 8px;
  }

}

.container {
  width:100%;
  max-width: 1200px;
  margin: auto;
}
</style>
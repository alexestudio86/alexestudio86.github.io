---

import articlesItems from "./articlesItems.data.json"

---

{
    articlesItems.map( (article) => (
        <article>
            <h1>{article.title}</h1>
            <p>{article.description}</p>
            <a href={article.url}>Go</a>
        </article>
    ))
}

<style>

    article {
        background:         var(--color-theme-one);
        border-radius:      10px;
        border:             1px solid rgb(54, 54, 54);
        padding:            10px;
        display:            flex;
        flex-direction:     column;
        justify-content:    space-between;
        height: 200px;
        max-height: 15vh;
        h1 {
            font-size:          var(--fontSize-theme-large);
        }
        p {
            font-size:          var(--fontSize-theme-medium);
        }
        a {
            text-decoration:    none;
            text-transform:     uppercase;
            font-size:          var(--fontSize-theme-small);
            color:              var(--color-theme-four);
        }
    }

</style>
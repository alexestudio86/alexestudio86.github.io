---

import projectsItems from "@sites/main/components/Projects/projectsItems.data.json";
import projectIcons from "./homepageProjectsIcons.js";

const uniqueItem = [
    ...new Set(
        projectsItems.flatMap( project => 
            project.icon
        )
    )
];

---

<section class="container">
    <h1>Proyectos</h1>
    <div class="articles">
        <!-- Carga de los svgs desde el principio para reciclarlos, filtrando únicamente los que aparecen en éste componente -->
        {
            uniqueItem.map( (svgIcon) => {
                const Component = projectIcons[svgIcon];
                return Component
                ? <Component techFW={svgIcon} />
                : null;
            } )
        }
        { projectsItems.length > 0 && projectsItems.map( (project) => (
            <article>
                <div>
                    <div>
                        <svg style={`width:var(--fontSize-theme-big); height:var(--fontSize-theme-big)`}>
                            <use href={`#${project.icon}-logo-symbol`} />
                        </svg>
                    </div>
                    <h2>{project.title}</h2>
                    <p>{project.shortDesc}</p>
                    <a href="#"></a>
                </div>
            </article>
        )) }
    </div>
    <p>
        <!-- Carga de los svgs desde el principio para reciclarlos, filtrando únicamente los que aparecen en éste componente -->
        {
            <projectIcons.southEast techFW={'southEast'} />
        }
        <a href="/proyectos">Ver proyectos <span>
                <svg style={`width:var(--fontSize-theme-medium); height:var(--fontSize-theme-medium)`}>
                    <use href={`#southEast-logo-symbol`} />
                </svg>
            </span>
        </a>
    </p>
</section>


<style>

    .articles {
        display:                grid;
        grid-template-columns:  repeat(auto-fit,minmax(200px, 1fr));
        gap:                    10px;
    }

    article {
        position:           relative;
        padding:            10px;
        background:         var(--color-dark);
        border-radius:      10px;
        border:             1px solid rgb(54, 54, 54);
        transition:         all 0.4s ease;
    }
    
    article:hover {
        border-color:       var(--color-theme-four);
        box-shadow:         0 0 15px var(--color-shadow-two);
        transform:          scale(1.05);
    }

    section {
        padding: 2rem 20px;
        div {
            article { 
                div {
                    display:            flex;
                    flex-direction:     column;
                    justify-content:    space-between;
                    height:             200px;
                    max-height:         20vh;
                    div {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                    }
                    transition:         transform 0.3s ease;
                    h1 {
                        font-size:          var(--fontSize-theme-medium);
                    }
                    p {
                        font-size:          var(--fontSize-theme-medium);
                    }
                    a {
                        position:           absolute;
                        inset: 0;
                        width: 100%;
                        height: 100%;
                        opacity:            0;
                        cursor:             pointer;
                    }
                }
            }
        }
        p {
            text-align: right;
            font-size:  var(--fontSize-theme-medium);
            padding:    20px 0;
            a {
                text-decoration:  none;
                color:            var(--color-link)
            }
            a:hover {
                color:          white;
            }
        }
    }


</style>
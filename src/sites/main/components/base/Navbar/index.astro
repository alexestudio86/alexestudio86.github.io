---

import HamburgerButton from "./Hamburger/index.astro";
const { menuItems, brandLogo } = Astro.props;

---

<nav>
  <div class="container">
    <div id="navbar">
      <a href="/">
        <img src={brandLogo.src} height="40" width="auto" alt="Logo Alex Estudio 86">
      </a>
      <input type="checkbox" id="chkToggle"></input>
      <HamburgerButton forId="chkToggle" />
      <ul>
        {menuItems.map( (item) => (
            <li>
              <a href={item.link}>{item.text}</a>
            </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<style>

  nav {
    position: sticky; /*A diferencia del fixed, sticky si ocupa espacio, debe estar acompañado por top*/
    /*top: 0;*/
    width: 100%;
    z-index: 3;
    padding: 20px 0;
  }

  #navbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items:center;
    background: var(--color-dark);
    border-radius: 18px;
    padding: 20px;
  }

  #navbar > input#chkToggle[type="checkbox"] {
    display: none;
  }

  #navbar > ul {
    list-style-type: none;
    display: flex;
    gap: 15px;
  }

  #navbar > a, #navbar > ul > li > a {
    text-decoration: none;
    color: var(--color-link);
    text-align: center;
  }

  #navbar > a:hover, #navbar > ul > li > a:hover {
    color: rgba(255, 255, 255, 1);
  }

  @media (width <= 768px) {

    /* El estado de un componente hijo no puede ser seteado desde el hijo, además se debe agregar el global*/
    #navbar > input#chkToggle:checked ~ :global(label) {
      --active: 1;
    }

    #navbar > input#chkToggle:checked ~ ul {
      right: 0;          /* Restauramos el padding */
    }

    #navbar > ul {
      position: fixed;
      top: 0;
      right: -100%;
      width: 100%;
      height: 100vh;
      flex-direction: column;
      background: var(--color-dark);
      overflow: hidden;
      transition: 0.3s ease-in-out;
      padding: 120px 40px;
      gap: 8px;
    }

    #navbar > input ~ ul > li {
      border: 1px solid var(--color-theme-three);
      border-radius: 4px;
      padding: 16px 8px;
    }

  }

</style>